{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/layout/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Old Standard TT))/i]",
        "message": "Font not provided by the design system. Available: Old Standard TT."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|as|href|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, size, as, href, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABand'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|number|title|action|onAction|style|key|ref|className|style|children)$/]",
        "message": "<CTABand> doesn't accept that prop. Declared props: label, number, title, action, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|state|hint|type|name|style|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, placeholder, value, onChange, state, hint, type, name, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:rest|focus|error)$/]",
        "message": "<FormField> state must be one of 'rest' | 'focus' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|src|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: height, src, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|children|surface|style|key|ref|className|style|children)$/]",
        "message": "<QuoteBand> doesn't accept that prop. Declared props: eyebrow, children, surface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteBand'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:rest|ink|brand)$/]",
        "message": "<QuoteBand> surface must be one of 'rest' | 'ink' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|children|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: number, children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|on-brand)$/]",
        "message": "<SectionLabel> tone must be one of 'accent' | 'on-brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|subtitle|children|surface|style|key|ref|className|style|children)$/]",
        "message": "<SegmentCard> doesn't accept that prop. Declared props: number, title, subtitle, children, surface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentCard'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:card|brand)$/]",
        "message": "<SegmentCard> surface must be one of 'card' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|phone|surface|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: items, active, phone, surface, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:transparent|ink|brand)$/]",
        "message": "<SiteHeader> surface must be one of 'transparent' | 'ink' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|children|style|key|ref|className|style|children)$/]",
        "message": "<StepItem> doesn't accept that prop. Declared props: number, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|onClick|size|showArrow|tone|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, onClick, size, showArrow, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|on-brand)$/]",
        "message": "<TextLink> tone must be one of 'default' | 'on-brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|on-brand)$/]",
        "message": "<Wordmark> tone must be one of 'default' | 'on-brand'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
